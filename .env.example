# ============================================================================
# Chronos Environment Configuration
# ============================================================================
# Copy this file to .env and customize for your environment
# Docker Compose will automatically load .env file
# ============================================================================

# ============================================================================
# Service Ports
# ============================================================================
API_GATEWAY_PORT=8080
WORKFLOW_SERVICE_PORT=8081
SCHEDULER_SERVICE_PORT=8082
WORKER_SERVICE_PORT=8083

# ============================================================================
# MongoDB Configuration
# ============================================================================
MONGODB_PORT=27017
MONGODB_ROOT_USERNAME=chronos
MONGODB_ROOT_PASSWORD=chronos123
MONGODB_DATABASE=chronos

# IMPORTANT: Change these credentials in production!
# Use strong passwords with at least 16 characters
# MONGODB_ROOT_PASSWORD=your-secure-password-here

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_PASSWORD=your-secure-redis-password

# ============================================================================
# Kafka Configuration
# ============================================================================
KAFKA_PORT=9092
KAFKA_HEAP_OPTS=-Xmx512M -Xms512M

# ============================================================================
# Security Configuration
# ============================================================================
# JWT Secret - MUST be at least 256 bits (32 characters) for HS256
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production-min-256-bits-required-generate-with-openssl-rand-base64-32

# JWT Token Expiration (milliseconds)
# 3600000 = 1 hour
# 86400000 = 24 hours
JWT_EXPIRATION_MS=3600000

# ============================================================================
# Observability Configuration
# ============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# IMPORTANT: Change in production!
# GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password

# ============================================================================
# Logging Configuration
# ============================================================================
# Logging levels: TRACE, DEBUG, INFO, WARN, ERROR
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_CHRONOS=DEBUG

# ============================================================================
# Application Configuration
# ============================================================================
# Spring Profile (docker, production, development)
SPRING_PROFILES_ACTIVE=docker

# Number of worker service replicas
WORKER_REPLICAS=3

# ============================================================================
# Resource Limits (Optional - Uncomment to enable)
# ============================================================================
# MongoDB
# MONGODB_MEM_LIMIT=512m
# MONGODB_CPUS=1.0

# Redis
# REDIS_MEM_LIMIT=256m
# REDIS_CPUS=0.5

# Kafka
# KAFKA_MEM_LIMIT=1g
# KAFKA_CPUS=1.0

# Zookeeper
# ZOOKEEPER_MEM_LIMIT=256m
# ZOOKEEPER_CPUS=0.5

# Services
# SERVICE_MEM_LIMIT=512m
# SERVICE_CPUS=1.0

# ============================================================================
# Development/Testing Flags
# ============================================================================
# Set to "true" to enable debug logging for infrastructure
DEBUG_INFRASTRUCTURE=false

# Set to "true" to disable authentication (DEVELOPMENT ONLY!)
DISABLE_AUTH=false

# ============================================================================
# Network Configuration
# ============================================================================
# Docker network subnet (advanced configuration)
# CHRONOS_NETWORK_SUBNET=172.25.0.0/16

# ============================================================================
# Volume Configuration
# ============================================================================
# Data persistence path (leave empty for Docker-managed volumes)
# CHRONOS_DATA_PATH=/opt/chronos/data

# ============================================================================
# Production Recommendations
# ============================================================================
# 1. Generate strong JWT secret: openssl rand -base64 32
# 2. Use strong passwords for all services (MongoDB, Grafana, etc.)
# 3. Set LOGGING_LEVEL_ROOT=WARN for production
# 4. Set LOGGING_LEVEL_COM_CHRONOS=INFO for production
# 5. Configure resource limits based on your infrastructure
# 6. Enable TLS/SSL for production deployments
# 7. Use external secret management (Vault, AWS Secrets Manager, etc.)
# 8. Regular backup of MongoDB and Redis data
# 9. Monitor disk usage for log files and metrics data
# 10. Set up proper network security groups/firewalls

# ============================================================================
# Quick Start Commands
# ============================================================================
# Start all services:
#   docker compose up -d
#
# View logs:
#   docker compose logs -f
#
# Stop all services:
#   docker compose down
#
# Clean restart (removes volumes):
#   docker compose down -v && docker compose up -d
#
# Scale workers:
#   docker compose up -d --scale worker-service=5
