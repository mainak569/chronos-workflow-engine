# ============================================================================
# Chronos environment configuration
# ============================================================================
# Copy to .env and adjust: cp .env.example .env
# Docker Compose reads .env automatically. Every variable below is used by
# docker-compose.yml; defaults apply when a variable is not set.
# ============================================================================

# ----------------------------------------------------------------------------
# Published ports
# ----------------------------------------------------------------------------
API_GATEWAY_PORT=8080
WORKFLOW_SERVICE_PORT=8081
SCHEDULER_SERVICE_PORT=8082
MONGODB_PORT=27017
REDIS_PORT=6379
KAFKA_PORT=9092
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Workers publish their application port on a host port in the range 8083-8093.

# ----------------------------------------------------------------------------
# Scaling
# ----------------------------------------------------------------------------
# Default number of worker replicas (docker compose up --scale worker-service=N overrides it)
WORKER_REPLICAS=3

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
# HMAC key for JWTs, shared by the API gateway and the workflow service.
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=your-secret-key-change-in-production-min-256-bits-required-generate-with-openssl-rand-base64-32

# Token lifetime in milliseconds (3600000 = 1 hour)
JWT_EXPIRATION_MS=3600000

# Enables the scheduler's operations API (/api/locks on port 8082, header X-Admin-Token).
# Leave empty to keep it disabled.
CHRONOS_ADMIN_TOKEN=

# Requests per minute allowed per user (or per IP for anonymous calls) through the gateway
GATEWAY_RATE_LIMIT_PER_MINUTE=120

# ----------------------------------------------------------------------------
# MongoDB
# ----------------------------------------------------------------------------
# Change these for anything beyond local development
MONGODB_ROOT_USERNAME=chronos
MONGODB_ROOT_PASSWORD=chronos123
MONGODB_DATABASE=chronos

# ----------------------------------------------------------------------------
# Kafka
# ----------------------------------------------------------------------------
KAFKA_HEAP_OPTS=-Xmx512M -Xms512M

# ----------------------------------------------------------------------------
# Grafana
# ----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ----------------------------------------------------------------------------
# Logging (TRACE, DEBUG, INFO, WARN, ERROR)
# ----------------------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_CHRONOS=DEBUG
