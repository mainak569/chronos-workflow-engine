{
  "dashboard": {
    "title": "Chronos - Workflow Execution",
    "tags": ["chronos", "workflows"],
    "timezone": "browser",
    "schemaVersion": 38,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "title": "Workflow Execution Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(chronos_workflow_executions_total[5m])",
            "legendFormat": "{{status}} - {{workflow_id}}"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Executions/sec"}
        ]
      },
      {
        "title": "Active Workflows",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(chronos_workflow_active)"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "title": "Workflow Success Rate",
        "type": "gauge",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rate(chronos_workflow_executions_total{status=\"COMPLETED\"}[5m]) / rate(chronos_workflow_executions_total[5m]) * 100"
          }
        ],
        "options": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 80},
              {"color": "green", "value": 95}
            ]
          }
        }
      },
      {
        "title": "Workflow Duration (p50, p95, p99)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(chronos_workflow_duration_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(chronos_workflow_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(chronos_workflow_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"}
        ]
      },
      {
        "title": "Top Failed Workflows",
        "type": "table",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "topk(10, sum by (workflow_id) (chronos_workflow_failures_total))",
            "format": "table",
            "instant": true
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [{"displayName": "Value", "desc": true}]
        }
      },
      {
        "title": "Workflow Failures by Error Type",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by (error_type) (chronos_workflow_failures_total)"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right"
          }
        }
      },
      {
        "title": "Workflow Execution Timeline",
        "type": "heatmap",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(chronos_workflow_duration_seconds_bucket[5m])"
          }
        ],
        "options": {
          "calculate": true,
          "calculation": {
            "xBuckets": {"mode": "size", "value": "1m"}
          },
          "cellGap": 1,
          "color": {
            "mode": "spectrum",
            "scheme": "Spectral"
          },
          "yAxis": {
            "unit": "s"
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "environment",
          "type": "query",
          "query": "label_values(chronos_workflow_executions_total, environment)",
          "multi": false,
          "includeAll": true
        },
        {
          "name": "workflow_id",
          "type": "query",
          "query": "label_values(chronos_workflow_executions_total, workflow_id)",
          "multi": true,
          "includeAll": true
        }
      ]
    }
  }
}
