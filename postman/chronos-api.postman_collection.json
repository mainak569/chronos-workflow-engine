              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('executionId', pm.response.json().executionId);",
                  "pm.test('starts PENDING', () => pm.expect(pm.response.json().status).to.eql('PENDING'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get execution (waits for completion)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workflows/executions/{{executionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workflows",
                "executions",
                "{{executionId}}"
              ]
            },
            "description": "When run in the Collection Runner or Newman this request re-runs itself until the execution finishes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "// Poll until the execution finishes (tasks are simulated and take ~1s each)",
                  "const body = pm.response.json();",
                  "const polls = Number(pm.collectionVariables.get('polls') || 0);",
                  "if (!['COMPLETED', 'FAILED', 'CANCELLED'].includes(body.status) && polls < 30) {",
                  "  pm.collectionVariables.set('polls', polls + 1);",
                  "  setTimeout(() => {}, 1000);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set('polls', 0);",
                  "  pm.test('execution completed', () => pm.expect(body.status).to.eql('COMPLETED'));",
                  "}"
                ]
              }
            }
          ]
        },
