            "description": "Runs every day at 02:00 (Spring cron: second minute hour day month weekday).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nightly report\",\n  \"schedule\": \"0 0 2 * * *\",\n  \"timezone\": \"UTC\",\n  \"tasks\": [\n    {\n      \"taskId\": \"report\",\n      \"name\": \"Build report\",\n      \"taskType\": \"DATA_PROCESSING\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
