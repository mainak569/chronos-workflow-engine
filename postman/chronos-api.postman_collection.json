            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Image Processing Pipeline\",\n  \"description\": \"Resize, compress and upload an image\",\n  \"tasks\": [\n    {\n      \"taskId\": \"resize\",\n      \"name\": \"Resize image\",\n      \"taskType\": \"IMAGE_RESIZE\",\n      \"configuration\": {\n        \"width\": 1280,\n        \"height\": 720\n      }\n    },\n    {\n      \"taskId\": \"compress\",\n      \"name\": \"Compress image\",\n      \"taskType\": \"IMAGE_COMPRESS\",\n      \"dependencies\": [\n        \"resize\"\n      ],\n      \"configuration\": {\n        \"quality\": 85\n      },\n      \"retryConfig\": {\n        \"maxAttempts\": 3,\n        \"initialDelayMs\": 2000,\n        \"backoffMultiplier\": 2.0,\n        \"maxDelayMs\": 60000\n      },\n      \"timeoutMs\": 60000\n    },\n    {\n      \"taskId\": \"validate\",\n      \"name\": \"Validate output\",\n      \"taskType\": \"DATA_VALIDATION\",\n      \"dependencies\": [\n        \"compress\"\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('workflowId', pm.response.json().workflowId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create scheduled workflow (cron)",
