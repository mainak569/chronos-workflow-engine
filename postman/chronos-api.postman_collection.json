{
  "info": {
    "_postman_id": "00000000-0000-0000-0063-68726f6e6f73",
    "name": "Chronos API",
    "description": "Chronos workflow orchestration API. Run the whole collection in order (Collection Runner or `npx newman run`): it registers a user, creates and executes a workflow, waits for completion, and cleans up. Requests go through the API gateway (`baseUrl`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate a unique user once per run",
          "if (!pm.collectionVariables.get('email')) {",
          "  const id = Date.now();",
          "  pm.collectionVariables.set('email', `postman${id}@example.com`);",
          "  pm.collectionVariables.set('username', `postman${id}`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "password",
      "value": "SecurePass123!"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "token",
