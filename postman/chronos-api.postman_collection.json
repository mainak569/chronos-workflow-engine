            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"imageUrl\": \"s3://bucket/photo.jpg\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
