              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('scheduledWorkflowId', pm.response.json().workflowId);",
                  "pm.test('schedule stored', () => pm.expect(pm.response.json().schedule).to.eql('0 0 2 * * *'));"
                ]
              }
            }
          ]
        },
